    pkgdesc='Right-click menu for sway windows: force close, copy PID, move and more'
    depends=(desktop-shell-components-common glib2 glibc gtk4 gtk4-layer-shell json-glib sway)
    backup=(
        etc/sway/config.d/60-desktop-shell-window-context-menu.conf
