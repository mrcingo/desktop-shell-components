    pkgdesc='Process ID in sway window title bars'
    depends=(cairo fontconfig glib2 glibc json-glib pango sway)
    backup=(
        etc/sway/config.d/60-desktop-shell-window-title-format.conf
        etc/xdg/desktop-shell-components/window-title-format.ini
    )
    install=desktop-shell-window-title-format.install

    _install_into_staging
    _take_program desktop-shell-window-title-format
    _take_files etc/sway/config.d/60-desktop-shell-window-title-format.conf
    _take_files etc/xdg/desktop-shell-components/window-title-format.ini
}

