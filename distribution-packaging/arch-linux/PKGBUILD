    )
    install=desktop-shell-window-context-menu.install

    _install_into_staging
    _take_program desktop-shell-window-context-menu
    _take_files usr/share/desktop-shell-components/window-context-menu.css etc/sway/config.d/60-desktop-shell-window-context-menu.conf
    _take_files etc/xdg/desktop-shell-components/window-context-menu.ini
}

package_desktop-shell-system-status-line() {
    pkgdesc='Status line for the sway bar: network, battery, processor, memory and more'
    depends=(glib2 glibc json-glib libpulse sway)
    optdepends=(
        'networkmanager: network and internet reachability'
        'upower: battery'
        'power-profiles-daemon: power profile'
        'bluez: Bluetooth'
        'desktop-shell-notification-daemon: notifications in the bar'
    )
    backup=(etc/xdg/desktop-shell-components/system-status-line.ini)
    install=desktop-shell-system-status-line.install

    _install_into_staging
    _take_program desktop-shell-system-status-line
    _take_files etc/xdg/desktop-shell-components/system-status-line.ini
}
