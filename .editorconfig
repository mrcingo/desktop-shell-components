# Editor settings matching .clang-format: spaces only, Unix line endings,
# plain text, a final newline.
root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 4
insert_final_newline     = true
trim_trailing_whitespace = true

[*.scd.in]
indent_style = tab
