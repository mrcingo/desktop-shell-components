# Starts the tray click window focus with sway. Installed by
# desktop-shell-tray-click-window-focus into /etc/sway/config.d, which
# sway's default configuration includes. Starting it again on reload is
# harmless: a second copy exits at once. Turn it off with "enabled = false"
# in ~/.config/desktop-shell-components/tray-click-window-focus.ini.

exec_always @bindir@/desktop-shell-tray-click-window-focus
