# Starts the window snapping program with sway. Installed by
# desktop-shell-window-snap into /etc/sway/config.d, which sway's default
# configuration includes. Starting it again on reload is harmless: a second
# copy exits at once. Turn it off with "enabled = false" in
# ~/.config/desktop-shell-components/window-snap.ini.
#
# By default title bars stay exactly as sway makes them: dragging one moves
# the window natively, smoothly and without anything in between. The
# program snaps the focused window from the keyboard (see window-snap.ini
# for the Win+arrow lines) and tidies useless tab groups.
#
# Drag-to-edge snapping with a preview, and double-click to maximize, are
# optional: they take over left presses on title bars and move the pointer
# through sway's seat commands to follow the drag, which can feel less
# direct. To try them, copy these two lines into your own sway
# configuration:
#
#   bindsym button1 mark --add _window-snap-target, nop desktop-shell-window-snap press
#   bindsym --release button1 nop desktop-shell-window-snap release
#
# The program switches to this mode only while such a drag is going on, so
# that Escape cancels it without taking the keyboard away from the focused
# application.

exec_always @bindir@/desktop-shell-window-snap

mode "desktop-shell-window-snap" {
    bindsym Escape nop desktop-shell-window-snap cancel
}
