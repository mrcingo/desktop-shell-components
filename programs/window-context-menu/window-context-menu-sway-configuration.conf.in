# Starts the window menu with sway and opens it when a window's title bar is
# right-clicked. Installed by desktop-shell-window-context-menu into
# /etc/sway/config.d, which sway's default configuration includes. Starting
# it again on reload is harmless: a second copy exits at once. Turn it off
# with "enabled = false" in ~/.config/desktop-shell-components/window-context-menu.ini.
#
# The mark tells the program which window was clicked: mouse bindings act on
# the window under the pointer.

exec_always @bindir@/desktop-shell-window-context-menu
bindsym button3 mark --add _window-context-menu-target, nop desktop-shell-window-context-menu
